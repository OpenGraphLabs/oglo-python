# Per-workstation choices for scripts/*.sh. Copy to scripts/workstation.env (ignored by git)
# and edit; scripts/_env.sh sources it. Variables already set in the shell win over this file.
# The values are examples; nothing here describes a particular machine.

# Interpreter with oglo and examples/camera_glove/requirements*.txt installed.
OGLO_PYTHON="$HOME/.venvs/oglo/bin/python"

# --camera for collect.sh: part of the camera's V4L2 name (stable across reboots) or an index.
# "SC233" matches the OVISION-EGO-V1 module; `v4l2-ctl --list-devices` shows the names.
OGLO_CAMERA="SC233"

# --codec for collect.sh when the camera goes through OpenCV (unused by the OVISION backend):
# mp4v, hevc_nvenc, h264_nvenc, libx265 or libx264.
OGLO_CODEC="mp4v"

# Hugging Face dataset repo for hf_upload.sh / dataset.py upload. Must be private, or not exist
# yet: an existing public repo is refused.
OGLO_HF_REPO="your-org/your-dataset"

# Optional: a token other than the machine-wide default, if this project has its own.
# export HF_TOKEN_PATH="$HOME/.secrets/hf/oglo/token"
